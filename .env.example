APP_NAME="Zytecs Research"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_GB

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=zytecs_research
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Local: "log" writes emails to storage/logs/mail.log. Production: "smtp" (see docs/EMAIL-CONFIGURATION.md).
MAIL_MAILER=log
MAIL_LOG_CHANNEL=mail
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="research@zytecs.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Zytecs Research -------------------------------------------------------
# Where new-brief and enquiry notifications are sent.
ZYTECS_NOTIFY_ADDRESS=research@zytecs.com
# Attach briefs up to this size (KB) to the notification email; 0 = secure admin link only.
ZYTECS_NOTIFY_ATTACH_MAX_KB=0
ZYTECS_NOTIFY_MAX_ATTEMPTS=3
# Drain the queue from the scheduler cron (set false if you run a supervised queue:work).
ZYTECS_SCHEDULED_QUEUE_WORKER=true
ZYTECS_OTP_EXPIRES_MINUTES=10
ZYTECS_OTP_MAX_ATTEMPTS=5
ZYTECS_OTP_RESEND_COOLDOWN=60
ZYTECS_UPLOAD_DISK=local
ZYTECS_UPLOAD_MAX_KB=20480
ZYTECS_RETENTION_DAYS=365
# Shown on PDF quotations, receipts and invoices (use | for new lines).
ZYTECS_INVOICE_ADDRESS=
ZYTECS_INVOICE_NOTE="Thank you for choosing Zytecs Research."
# Set true after the privacy policy and terms have had legal review.
ZYTECS_POLICIES_REVIEWED=false
# Comma-separated proxy IPs (or *) when behind a load balancer / Cloudflare.
TRUSTED_PROXIES=

# Laravel Boost (dev only): its browser logger injects an inline script that the CSP blocks.
BOOST_BROWSER_LOGS_WATCHER=false
